+// build9: persistent streaming drain. consumeData reads ONE program's
+// result and exits at its trailer (short read); this variant keeps going
+// across programs — each short read is one program's TLAST/trailer, its
+// 8192 B (READ) / 2048 B (SEG_POP) payload is stripped of the 32 B
+// trailer and pushed into api_recv_buf in stream order, and the loop
+// continues to the next program. Runs until stream_stop_req AND the c2h
+// stream is quiet (a tick-bounded read makes the empty-stream wait
+// interruptible, same mechanism as the accum receiver). READ/SEG_POP
+// framing only — never entered for accum/DIFF modes.
+void SoftMCPlatform::consumeDataStream()
+{
+  const int CHUNK = 32 * 1024;
+  static const bool s_recv_debug = []{
+    const char* v = getenv("PIM_RECV_DEBUG");
+    return v && *v && atoi(v) != 0;
+  }();
+  // reuse the accum receiver's tick timer so an idle stream (stop
+  // requested, nothing left) returns from the kernel read instead of
+  // blocking forever. Tick period from PIM_ACCUM_TICK_MS (default 100).
+  static const long s_tick_ms = []{
+    const char* v = getenv("PIM_ACCUM_TICK_MS");
+    long vv = (v && *v) ? atol(v) : 100;
+    if (vv <= 0) vv = 100; if (vv > 999) vv = 999; return vv;
+  }();
+  std::call_once(s_accum_tick_once, []{
+    struct sigaction sa; memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = accum_tick_noop; sigemptyset(&sa.sa_mask); sa.sa_flags = 0;
+    sigaction(PIM_ACCUM_TICK_SIG, &sa, nullptr);
+  });
+  timer_t tick_timer; bool have_timer = false;
+  { struct sigevent sev; memset(&sev, 0, sizeof(sev));
+    sev.sigev_notify = SIGEV_THREAD_ID; sev.sigev_signo = PIM_ACCUM_TICK_SIG;
+    sev.sigev_notify_thread_id = (pid_t)syscall(SYS_gettid);
+    if (timer_create(CLOCK_MONOTONIC, &sev, &tick_timer) == 0) {
+      struct itimerspec its; its.it_value.tv_sec = 0;
+      its.it_value.tv_nsec = s_tick_ms * 1000000L; its.it_interval = its.it_value;
+      if (timer_settime(tick_timer, 0, &its, nullptr) == 0) have_timer = true;
+      else timer_delete(tick_timer);
+    }
+  }
+  // Robust record parser. Each program's c2h is exactly
+  // (payload + 32 B trailer). We do NOT rely on a per-program short read
+  // to find the boundary — the backend may frame per-program (silicon
+  // TLAST → one short read each) OR coalesce several programs into one
+  // kernel read (the sim exposed this, 07-22). Instead we track a byte
+  // offset within the current record: bytes 0..payload-1 are pushed,
+  // bytes payload..payload+31 are dropped (trailer), then the record
+  // repeats. Partial records survive across kernel reads because rec_off
+  // is a persistent cursor.
+  //
