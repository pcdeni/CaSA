+    if (stream_stop_req.load(std::memory_order_acquire) && rec_off == 0 &&
+        (!sized || (!have_rec && stream_size_q.empty()))) break;
+    std::this_thread::yield();
+  }
+  if (proto_err) recv_timed_out = true;
