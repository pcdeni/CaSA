+// build9 (2026-07-22): STREAM_EN control word (bit INSTR_WIDTH+11 =
+// byte[9] bit 3 = 0x08; payload bit0 in byte[0] = on/off). Enables the
+// frontend's ping-pong streaming fetch: the host may load program N+1
+// into the idle IMEM bank while N executes, so the DDR command bus stops
+// waiting on per-program host round-trips (docs/STREAMING_FETCH_DESIGN).
+// Idempotent SET, same mechanism as the +5..+10 words. HAZARD: never
+// call on a pre-build9 image (the word falls through the decode into
+// instruction-load). Sending it is h2c-only; no readback.
+void SoftMCPlatform::set_stream_en(bool on)
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x08;   // INSTR_WIDTH+11
+  ((uint8_t*) instr_buf)[0] = on ? (uint8_t)0x01 : (uint8_t)0x00;
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not set STREAM_EN!" << std::endl;
+  else std::cout << "Set STREAM_EN: " << (on ? "on" : "off")
+                 << " (build9 SET word)." << std::endl;
+}
+
+// ---- build9 host streaming primitives ----
+// The frontend streams programs; the host becomes a pure producer. Unlike
+// execute() (one receiver per program, joined before the next send —
+// which serializes on the HOST even though the FPGA pipelines), streaming
+// runs ONE persistent drain thread that reads the concatenated c2h result
+// stream and splits it on the per-program TLAST/trailer, pushing each
+// program's payload into api_recv_buf in order. stream_send() then only
+// sends h2c (XDMA back-pressures via the frontend's tready when the idle
+// bank is full), and stream_recv() pops one program's result.
+//
+// SCOPE (host contract, mirrors the RTL v1 scope): READ / SEG_POP only.
+// Accum-family modes are NOT streamable (their capture assumes read-quiet
+// windows). Call set_stream_en(true) on the FPGA BEFORE stream_start().
+// payload_bytes = the per-program readback payload (8192 READ, 2048
+// SEG_POP) — the drain parses the c2h stream into (payload+32) records,
+// so it is correct whether the backend frames per-program or coalesces.
+void SoftMCPlatform::stream_start(int payload_bytes)
+{
+  // >0: uniform records of that size. <=0 (STREAM_SIZED): per-program
+  // sizes via stream_send(prog, payload_bytes) -> stream_size_q.
+  stream_payload_bytes = payload_bytes;
+  while (stream_size_q.pop()) {}   // clear any stale sizes from a prior session
+  if(is_dummy) return;
+  if(receiver.joinable()) {                 // drain any prior per-program receiver
+    if(!receiver_done.load(std::memory_order_acquire)) {
+      long guard_ms = 0;
+      if (const char* v = getenv("PIM_RECV_TIMEOUT_MS")) if (*v) guard_ms = atol(v);
+      if (guard_ms > 0) {
+        auto t0 = std::chrono::steady_clock::now();
+        while(!receiver_done.load(std::memory_order_acquire)) {
+          if (std::chrono::duration_cast<std::chrono::milliseconds>(
+                  std::chrono::steady_clock::now()-t0).count() >= guard_ms) {
+            recv_timed_out = true; receiver.detach(); break; }
+          std::this_thread::yield();
+        }
+      }
+    }
+    if(receiver.joinable()) receiver.join();
+  }
+  stream_stop_req.store(false, std::memory_order_release);
+  receiver_done.store(false, std::memory_order_release);
+  stream_session_on.store(true, std::memory_order_release);
+  // Install the tick no-op handler BEFORE the thread exists: stream_stop
+  // pthread_kills the drain with this signal, and an early stop racing
+  // the drain's own install would otherwise hit the default action
+  // (process termination).
+  std::call_once(s_accum_tick_once, []{
+    struct sigaction sa; memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = accum_tick_noop; sigemptyset(&sa.sa_mask); sa.sa_flags = 0;
+    sigaction(PIM_ACCUM_TICK_SIG, &sa, nullptr);
+  });
+  receiver = std::thread(&SoftMCPlatform::consumeDataStream, this);
+}
+
+void SoftMCPlatform::stream_send(Program &prog, int payload_bytes)
+{
+  if(is_dummy) { free(prog.get_inst_array()); return; }
+  if(recv_timed_out) {
+    std::cerr << "[platform] stream_send SKIPPED: platform poisoned." << std::endl;
+    free(prog.get_inst_array()); return;
+  }
+  const bool sized = (stream_payload_bytes <= 0);
+  if (sized && payload_bytes < 0) {
+    std::cerr << "[platform] stream_send: SIZED session but no "
+              << "payload_bytes given — poisoning (stream would desync)\n";
+    recv_timed_out = true; free(prog.get_inst_array()); return;
+  }
+  uint64_t* iseq = (uint64_t*) prog.get_inst_array();
+  int bytes   = prog.size();
+  int n_inst  = bytes / 8;
+  static int s_bitstream_imem = []{
+    const char* v = getenv("BITSTREAM_IMEM");
+    int vv = (v && *v) ? atoi(v) : BITSTREAM_IMEM_INSTS;
+    return vv > 0 ? vv : BITSTREAM_IMEM_INSTS;
+  }();
+  if(n_inst > s_bitstream_imem) {
+    // A skipped streamed program = a missing record = every later
+    // result attributed to the wrong program. Unlike execute()'s
+    // skip-and-count, streaming must POISON. Gate sizes upstream.
+    std::cerr << "[platform] stream_send: program too large ("
+              << n_inst << " > " << s_bitstream_imem
+              << ") — POISONING (no silent skip in a stream)\n";
+    n_oversize_skips++; recv_timed_out = true; free(iseq); return;
+  }
+  // Push the size BEFORE h2c: the drain pops it at record start, and no
+  // c2h byte of this program can exist before sendData below returns.
+  if (sized) stream_size_q.push(payload_bytes);
+  uint64_t* temp_ptr = (uint64_t*) instr_buf;
+  for(int i = 0; i < bytes/8; i++) temp_ptr[i*4] = iseq[i];
+  int sent = iface -> sendData(instr_buf, bytes*4);
+  memset(instr_buf, 0, bytes*4);
+  free(iseq);
+  if(sent) { std::cerr << "[platform] stream_send h2c FAILED — poisoning\n";
+             recv_timed_out = true; }
+}
+
+int SoftMCPlatform::stream_recv(void* dst_buf, int size)
+{
+  return receiveData(dst_buf, size);   // same lock-free queue the drain fills
+}
+
+void SoftMCPlatform::stream_stop()
+{
+  if(is_dummy) return;
+  stream_session_on.store(false, std::memory_order_release);
+  stream_stop_req.store(true, std::memory_order_release);
+  // Kick the drain out of its tick-bounded kernel read NOW instead of
+  // waiting for the next periodic tick (up to PIM_ACCUM_TICK_MS): the
+  // per-request session teardown otherwise costs ~tens of ms × every
+  // request (measured 64.8→87.3 s on the layer-0 gate, 2026-07-22 —
+  // the whole regression was this latency). Same no-op signal the
+  // drain's own timer uses; harmless if the thread is already past the
+  // read or finished.
+  if(receiver.joinable() && !receiver_done.load(std::memory_order_acquire))
+    pthread_kill(receiver.native_handle(), PIM_ACCUM_TICK_SIG);
+  if(receiver.joinable()) {
+    long guard_ms = 0;
+    if (const char* v = getenv("PIM_RECV_TIMEOUT_MS")) if (*v) guard_ms = atol(v);
+    if (guard_ms > 0 && !receiver_done.load(std::memory_order_acquire)) {
+      auto t0 = std::chrono::steady_clock::now();
+      while(!receiver_done.load(std::memory_order_acquire)) {
+        if (std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now()-t0).count() >= guard_ms) {
+          recv_timed_out = true; receiver.detach(); return; }
+        std::this_thread::yield();
+      }
+    }
+    receiver.join();
+  }
+}
