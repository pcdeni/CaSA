+  // Zero-size records (write-only programs) are just 32-B trailers.
+  const bool sized = (stream_payload_bytes <= 0);
+  int PAY = sized ? 0 : stream_payload_bytes;
+  int REC = PAY + 32;
+  bool have_rec = !sized;      // sized: must pop a size at record start
+  bool proto_err = false;
+  int rec_off = 0;
+  while (true) {
+    int got = iface->recvData(xdma_recv_buf, CHUNK);
+    if (got > 0) {
+      if (s_recv_debug)
+        fprintf(stderr, "[recv-debug] stream got=%d rec_off=%d\n", got, rec_off);
+      const char* p = (const char*)xdma_recv_buf;
+      int left = got;
+      while (left > 0) {
+        if (sized && !have_rec) {
+          int sz = -1;
+          while (!stream_size_q.pop(sz)) {
+            if (stream_stop_req.load(std::memory_order_acquire)) break;
+            std::this_thread::yield();
