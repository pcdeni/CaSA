+void SoftMCPlatform::toggle_readback_mode()
+{
+  if(is_dummy)
+  {
+    return;
+  }
+  ((uint8_t*) instr_buf)[8] = (uint8_t) 2;   // bit INSTR_WIDTH+1
+  int sent = iface -> sendData(instr_buf, 32 /*in bytes*/);
+  memset(instr_buf, 0, 32);
+  if(sent)
+    std::cerr << "Could not toggle readback mode!" << std::endl;
+  else
+    std::cout << "Toggled readback mode." << std::endl;
+}
+
+// build4+ images ONLY (trailer magic 0xDBC0DE02) — see platform.h.
+// SET-READ = bit INSTR_WIDTH+5 (byte[8] = 0x20), SET-DIFF = bit
+// INSTR_WIDTH+6 (byte[8] = 0x40). Idempotent: safe to send repeatedly;
+// a duplicate is a no-op, a lost word is repaired by resending.
+void SoftMCPlatform::set_readback_mode(bool diff)
+{
+  if(is_dummy)
+  {
+    return;
+  }
+  ((uint8_t*) instr_buf)[8] = diff ? (uint8_t) 0x40 : (uint8_t) 0x20;
+  int sent = iface -> sendData(instr_buf, 32 /*in bytes*/);
+  memset(instr_buf, 0, 32);
+  if(sent)
+    std::cerr << "Could not set readback mode ("
+              << (diff ? "DIFF" : "READ") << ")!" << std::endl;
+  else
+    std::cout << "Set readback mode: " << (diff ? "DIFF" : "READ")
+              << " (build4 SET word)." << std::endl;
+}
