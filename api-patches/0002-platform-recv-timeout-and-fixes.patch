+int SoftMCPlatform::receiveData(void* recv_buf, int size){
+  assert(size > 0 && size % 4 == 0 && "size must be a positive multiple of 4");
+  if(is_dummy) {
+    memset(recv_buf, 0, size);
+    return size;
+  }
+  // Pop `size` bytes from the api_recv_buf the receiver thread is
+  // filling. Same semantics as the pristine SiMRA api, but yield to
+  // the scheduler when the queue is momentarily empty so we don't peg
+  // a host CPU at 100% spinning while the producer thread is doing the
+  // kernel read. (Original code busy-looped — fine in microbenchmarks
+  // but wastes a core when >1 process per host runs in parallel.)
+  // Already poisoned by an earlier timeout — fail fast (0 bytes) instead of
+  // waiting the full window again on every subsequent call.
+  if (recv_timed_out)
+    return 0;
+  size /= 4;
+  int total_words = size;
+  int rd = 0;
+  // Opt-in stall guard (PIM_RECV_TIMEOUT_MS, see platform.h). Resolved once;
+  // 0/unset keeps the pristine block-forever semantics with zero clock calls
+  // in the spin path.
+  static const long s_recv_timeout_ms = []{
+    const char* v = getenv("PIM_RECV_TIMEOUT_MS");
+    long vv = (v && *v) ? atol(v) : 0;
+    if (vv > 0)
+      std::cerr << "[platform] PIM_RECV_TIMEOUT_MS in effect: " << vv << std::endl;
+    return vv;
+  }();
+  auto last_progress = std::chrono::steady_clock::now();
+  while (rd < total_words) {
+    int got = api_recv_buf.pop((int*)recv_buf + rd, total_words - rd);
+    if (got == 0) {
+      if (s_recv_timeout_ms > 0 &&
+          std::chrono::duration_cast<std::chrono::milliseconds>(
+              std::chrono::steady_clock::now() - last_progress).count()
+              >= s_recv_timeout_ms) {
+        recv_timed_out = true;
+        std::cerr << "[platform] receiveData TIMEOUT: no c2h data for "
+                  << s_recv_timeout_ms << " ms; got " << rd * 4 << "/"
+                  << total_words * 4 << " bytes (FPGA c2h stall). Platform is"
+                  << " poisoned — reset the rig or exit; do not retry."
+                  << std::endl;
+        return rd * 4;
+      }
+      std::this_thread::yield();
+    } else if (s_recv_timeout_ms > 0) {
