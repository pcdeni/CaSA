+// build8 (ACCUM_XBP) control words. byte[8] bit7 (0x80) = INSTR_WIDTH+7
+// (SEG_POP); byte[9] bits 0/1/2 = INSTR_WIDTH+8/9/10. All idempotent SET
+// words, same mechanism as the +5/+6/+7 words. Image = trailer 0xDBC0DE06.
+// HAZARD: never call these on a pre-build8 image (the words fall through
+// the frontend decode into instruction-load).
+void SoftMCPlatform::set_readback_mode_accxbp()
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x01;   // INSTR_WIDTH+8
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not set readback mode (ACCUM_XBP)!" << std::endl;
+  else {
+    std::cout << "Set readback mode: ACCUM_XBP (build8 SET word)." << std::endl;
+    bool was = accum_mode.exchange(false, std::memory_order_relaxed);
+    if (was) transition_drains_left = 1;
+  }
+}
+
+// Latch the per-plane weight: neg (sign) + shift (3-bit, = the bit-plane
+// power-of-two). Payload in h2c_tdata[3:0] (byte[0] low nibble), decoded
+// by the frontend as {neg, shift[2:0]} and sampled by the engine only
+// under this SET word. Sent BETWEEN bit-plane programs (h2c-only, no read).
+void SoftMCPlatform::set_acc_weight(int neg, int shift)
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[0] = (uint8_t)(((neg & 1) << 3) | (shift & 7));
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x02;   // INSTR_WIDTH+9
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not set acc weight!" << std::endl;
+}
+
+// Arm the accumulator drain: the engine streams its 128 words as one c2h
+// message and zeroes itself. Caller then receiveData(8192) once.
+//
+// The drain message has NO program behind it — no execute() runs, so no
+// receiver thread exists to move it from the kernel c2h ring into
+// api_recv_buf, and receiveData() (which only pops that queue) would
+// block on nothing. (Silicon 2026-07-22: first accxbp-hw-exe run timed
+// out 0/8192 exactly this way.) So THIS call provides the reader: spawn
+// the bounded accum receiver — exits at its first complete message, the
+// 8192 B payload + 32 B trailer — BEFORE the h2c word, mirroring
+// execute()'s spawn-before-send order and its guarded join of a
+// possibly-stuck previous receiver.
+void SoftMCPlatform::flush_acc()
+{
+  if(is_dummy) return;
+  if (recv_timed_out) {
+    std::cerr << "[platform] flush_acc() SKIPPED: platform poisoned by an"
+              << " earlier receiveData timeout." << std::endl;
+    return;
+  }
+  if(receiver.joinable()) {
+    long guard_ms = 0;
+    if (const char* v = getenv("PIM_RECV_TIMEOUT_MS")) if (*v) guard_ms = atol(v);
+    if (guard_ms > 0 && !receiver_done.load(std::memory_order_acquire)) {
+      auto t0 = std::chrono::steady_clock::now();
+      while (!receiver_done.load(std::memory_order_acquire)) {
+        if (std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - t0).count() >= guard_ms) {
+          fprintf(stderr, "[platform] drain thread stuck in kernel c2h read"
+                  " for %ld ms — poisoning platform, detaching thread. Reset"
+                  " the rig before further use.\n", guard_ms);
+          recv_timed_out = true;
+          receiver.detach();
+          return;
+        }
+        std::this_thread::yield();
+      }
+    }
+    receiver.join();
+  }
+  receiver_done.store(false, std::memory_order_release);
+  receiver_quiet_drain = false;      // exit at the first complete message
+  receiver_flush_wait  = true;       // strip glued trailers, wait for payload
+  receiver = std::thread(&SoftMCPlatform::consumeDataAccum, this);
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x04;   // INSTR_WIDTH+10
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not flush accumulator!" << std::endl;
+}
