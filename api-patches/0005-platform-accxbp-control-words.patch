+// build7 (2026-07-21): SET SEG_POP readback mode (bit INSTR_WIDTH+7,
+// byte[8]=0x80). SEG_POP streams a fixed 2048 B/row then a trailer — it is
+// READ-like framing, NOT accum/DIFF, so the host uses the pristine
+// consumeData receiver (accum_mode=false) and receiveData(2048). Entering
+// from DIFF arms one transition drain, same as entering READ. Idempotent.
+void SoftMCPlatform::set_readback_mode_segpop()
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[8] = (uint8_t) 0x80;
+  int sent = iface -> sendData(instr_buf, 32 /*in bytes*/);
+  memset(instr_buf, 0, 32);
+  if(sent)
+    std::cerr << "Could not set readback mode (SEG_POP)!" << std::endl;
+  else {
+    std::cout << "Set readback mode: SEG_POP (build7 SET word)." << std::endl;
+    bool was = accum_mode.exchange(false, std::memory_order_relaxed);
+    if (was) transition_drains_left = 1;   // DIFF -> SEG_POP: arm one drain
+  }
+}
+
+// build8 (ACCUM_XBP) control words. byte[8] bit7 (0x80) = INSTR_WIDTH+7
+// (SEG_POP); byte[9] bits 0/1/2 = INSTR_WIDTH+8/9/10. All idempotent SET
+// words, same mechanism as the +5/+6/+7 words. Image = trailer 0xDBC0DE06.
+// HAZARD: never call these on a pre-build8 image (the words fall through
+// the frontend decode into instruction-load).
+void SoftMCPlatform::set_readback_mode_accxbp()
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x01;   // INSTR_WIDTH+8
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not set readback mode (ACCUM_XBP)!" << std::endl;
+  else {
+    std::cout << "Set readback mode: ACCUM_XBP (build8 SET word)." << std::endl;
+    bool was = accum_mode.exchange(false, std::memory_order_relaxed);
+    if (was) transition_drains_left = 1;
+  }
+}
+
+// Latch the per-plane weight: neg (sign) + shift (3-bit, = the bit-plane
+// power-of-two). Payload in h2c_tdata[3:0] (byte[0] low nibble), decoded
+// by the frontend as {neg, shift[2:0]} and sampled by the engine only
+// under this SET word. Sent BETWEEN bit-plane programs (h2c-only, no read).
+void SoftMCPlatform::set_acc_weight(int neg, int shift)
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[0] = (uint8_t)(((neg & 1) << 3) | (shift & 7));
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x02;   // INSTR_WIDTH+9
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not set acc weight!" << std::endl;
+}
+
+// Arm the accumulator drain: the engine streams its 128 words as one c2h
+// message and zeroes itself. Caller then receiveData(8192) once.
+void SoftMCPlatform::flush_acc()
+{
+  if(is_dummy) return;
+  ((uint8_t*) instr_buf)[9] = (uint8_t) 0x04;   // INSTR_WIDTH+10
+  int sent = iface -> sendData(instr_buf, 32);
+  memset(instr_buf, 0, 32);
+  if(sent) std::cerr << "Could not flush accumulator!" << std::endl;
+}
