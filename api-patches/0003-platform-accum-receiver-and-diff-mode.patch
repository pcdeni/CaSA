+// Bounded stray-drain — see platform.h. Centralizes the popcount tool's
+// recover-mode loop ("set READ + bounded drain"). Pops and discards
+// whatever the receiver thread(s) have pushed; a zero-byte try means the
+// queue is quiet, so stop early. Never poisons.
+int SoftMCPlatform::drain_stray(long try_ms, int max_tries)
+{
+  if (is_dummy) return 0;
+  char scratch[4096];
+  int total = 0;
+  for (int i = 0; i < max_tries; i++) {
+    int rx = receiveDataTry(scratch, (int)sizeof(scratch), try_ms);
+    total += rx;
+    if (rx == 0 || recv_stalled()) break;
+  }
+  if (total > 0)
+    fprintf(stderr, "[platform] drain_stray: discarded %d stray bytes\n", total);
+  return total;
+}
