+// Bounded per-execute drain for DIFF/accum mode (build5, 2026-07-20 —
+// RESULT.md addendum 20f). Measured delivery model on silicon: each accum
+// message is self-framed (64 B chunk + 32 B trailer, 96 B delivered
+// together), but the XDMA c2h engine surfaces a completed small message
+// to the host only when the NEXT program's c2h traffic arrives — a
+// one-program surface lag downstream of the readback FIFO, not fixable by
+// RTL trailer gating. Consequence: the FINAL program of any batch has an
+// empty receive window, and the pristine consumeData would block forever
+// in the kernel cyclic read (600 s wait), poisoning the platform at the
+// next join and wedging h2c.
+//
+// This receiver instead mirrors receiveDataTry's bounded-deadline poll on
+// the KERNEL side: a per-thread periodic tick (timer_create with
+// SIGEV_THREAD_ID -> PIM_ACCUM_TICK_SIG, no-op handler, no SA_RESTART)
+// makes the kernel's interruptible wait return ~every TICK_MS with 0
+// bytes when nothing has surfaced; we exit CLEANLY once no data has
+// arrived for PIM_ACCUM_QUIET_MS (default 500 ms). No poisoning — an
+// empty window is an EXPECTED outcome in this mode. Every message that
+// does surface (this program's, or a lagged one from an earlier program)
+// is trailer-stripped and pushed into api_recv_buf in FIFO order, exactly
+// where receiveDataTry consumers look for it; messages that surface later
+// are pushed by a later execute's window.
+//
+// Exit policy (receiver_quiet_drain, set by execute()):
+//  * normal accum execute: exit right after the FIRST complete message
+//    (short read), like the pristine receiver — one message per window
+//    keeps the inter-program cadence at the pre-fix envelope (silicon
+//    2026-07-20: stretching the suite ~10x by lingering after each
+//    message pushed DIFF-mode dwell past ~5 s and the 10th program's h2c
+//    send wedged at the FPGA; at the tight cadence the same ordinal is
+//    fine). A second message that surfaced in the same lump stays in the
+//    kernel cyclic ring and is harvested by the next window's read.
+//  * transition execute (first post-DIFF program): keep draining until a
+//    full quiet window, so the stranded final message AND the program's
+//    own trailer are both absorbed, leaving the stream at a clean
+//    program boundary.
+void SoftMCPlatform::consumeDataAccum()
+{
+  const int CHUNK = 32 * 1024;
+  static const bool s_recv_debug = []{
+    const char* v = getenv("PIM_RECV_DEBUG");
+    return v && *v && atoi(v) != 0;
+  }();
+  static const long s_quiet_ms = []{
+    const char* v = getenv("PIM_ACCUM_QUIET_MS");
+    long vv = (v && *v) ? atol(v) : 500;
+    return vv > 0 ? vv : 500;
+  }();
+  // Batched-stream campaigns (lane2 LANE2_ACCUM) shrink both knobs (e.g.
+  // 5/5 ms) so an empty window costs ~one tick instead of 500 ms; a message
+  // that surfaces after its own window exits just waits in the kernel ring
+  // for the next window's read (FIFO order preserved). Defaults unchanged.
+  static const long s_tick_ms = []{
+    const char* v = getenv("PIM_ACCUM_TICK_MS");
+    long vv = (v && *v) ? atol(v) : 100;
+    if (vv <= 0) vv = 100;
+    if (vv > 999) vv = 999;   // tv_nsec-encoded below; keep it sub-second
+    return vv;
+  }();
+  const long TICK_MS = s_tick_ms;
+  // The transition drain (first post-DIFF execute) must absorb the stranded
+  // final message no matter how aggressive the campaign knobs are — floor
+  // its quiet window at the pristine 500 ms.
+  const long QUIET_MS = receiver_quiet_drain
+                            ? (s_quiet_ms < 500 ? 500 : s_quiet_ms)
+                            : s_quiet_ms;
+
+  std::call_once(s_accum_tick_once, []{
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = accum_tick_noop;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;                    // deliberately NO SA_RESTART
+    sigaction(PIM_ACCUM_TICK_SIG, &sa, nullptr);
+  });
+
+  timer_t tick_timer;
+  bool have_timer = false;
+  {
+    struct sigevent sev;
+    memset(&sev, 0, sizeof(sev));
+    sev.sigev_notify = SIGEV_THREAD_ID;
+    sev.sigev_signo = PIM_ACCUM_TICK_SIG;
+    sev.sigev_notify_thread_id = (pid_t)syscall(SYS_gettid);
+    if (timer_create(CLOCK_MONOTONIC, &sev, &tick_timer) == 0) {
+      struct itimerspec its;
+      its.it_value.tv_sec = 0;
+      its.it_value.tv_nsec = TICK_MS * 1000000L;
+      its.it_interval = its.it_value;
+      if (timer_settime(tick_timer, 0, &its, nullptr) == 0)
+        have_timer = true;
+      else
+        timer_delete(tick_timer);
+    }
+  }
+  if (!have_timer)
+    fprintf(stderr, "[platform] accum drain: tick timer unavailable — "
+            "kernel reads unbounded this execute\n");
+
+  auto last_data = std::chrono::steady_clock::now();
+  while (true) {
+    int got = iface->recvData(xdma_recv_buf, CHUNK);
+    if (got > 0) {
+      int useful = (got < CHUNK) ? got - 32 : got;
+      if (s_recv_debug) {
+        fprintf(stderr, "[recv-debug] accum got=%d useful=%d\n", got, useful);
+        if (got < CHUNK && got >= 32) {
+          const uint32_t* t = (const uint32_t*)((const char*)xdma_recv_buf + got - 32);
+          fprintf(stderr, "[recv-debug] trailer:");
+          for (int i = 0; i < 8; i++) fprintf(stderr, " %08x", t[i]);
+          fprintf(stderr, "\n");
+        }
+      }
+      if (useful > 0) {
+        int total = useful / 4;
+        int pushed = api_recv_buf.push((int*)xdma_recv_buf, total);
+        while (pushed < total)
+          pushed += api_recv_buf.push((int*)xdma_recv_buf + pushed,
+                                     total - pushed);
+      }
+      if (got < CHUNK && !receiver_quiet_drain)
+        break;    // complete message consumed — pristine-style exit
+      last_data = std::chrono::steady_clock::now();
+      continue;   // transition drain (or full chunk): keep reading
+    }
+    if (got < 0) {
+      // Real kernel-side error (the tick path returns 0, not <0). Exit
+      // cleanly; consumers just see no further data, no poison here.
+      if (s_recv_debug)
+        fprintf(stderr, "[recv-debug] accum recv error (got=%d) — receiver exits\n", got);
+      break;
+    }
+    // got == 0: tick-interrupted with nothing surfaced (or empty harvest).
+    if (std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - last_data).count() >= QUIET_MS)
+      break;      // clean quiet-window exit — the expected accum outcome
+    std::this_thread::yield();   // kernel path self-paces via the tick;
+                                 // this guards non-blocking backends (sim)
+  }
+  if (have_timer)
+    timer_delete(tick_timer);
+  receiver_done.store(true, std::memory_order_release);
+}
