 {
   Program p;
 
+  // Set the read loop's bound, exactly as the wrRow_* helpers already do.
+  // Without it the loop INHERITS NUM_COLS_REG from whatever program ran
+  // last on this platform. The loop is a do-while, so an inherited 0 or 1
+  // yields exactly ONE read (64 B) while the caller waits for a full
+  // 8192 B row: receiveData then blocks to its timeout and poisons the
+  // platform. Deterministic, and invisible until a read helper is the
+  // first read-bearing program after a write-only one.
+  p.add_inst(SMC_LI(128, NUM_COLS_REG));
   p.add_inst(SMC_LI(row_immd, RAR));
   p.add_inst(SMC_LI(0, CAR));
   p.add_inst(SMC_LI(0, LOOP_COLS));
