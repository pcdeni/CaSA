 // Allocate per-bank backup rows for a new handle and per-col write the
 // supplied weight masks into them. Returns 0 on success, -1 on error
 // (e.g., backup pool exhausted).
+// [#67 2026-08-04 conveyor] Per-bank/subset handle residency helpers. A handle
+// records the ORDERED global bank-ids its columns map to (h.bank_ids). These are
+// the single place the "empty bank_ids == legacy full-set, positional" fallback
+// is interpreted, so LOAD / serve / invalidate all agree.
+
+// PIM_HANDLE_SUBSET (default 0): honour an optional per-LOAD bank-subset field.
+// 0 => trailing subset bytes (if any) are ignored, every handle spans the full
+// active set => byte-identical to the #65 production superset.
+static int g_handle_subset = -1;
+static bool handle_subset_on() {
+  if (g_handle_subset < 0) {
+    const char* v = getenv("PIM_HANDLE_SUBSET");
+    g_handle_subset = (v && *v) ? atoi(v) : 0;
+    if (g_handle_subset > 0)
+      fprintf(stderr, "[server] PIM_HANDLE_SUBSET=1: per-LOAD bank-subset field "
+              "honoured; handle residency is per-bank (task #67 conveyor)\n");
+  }
+  return g_handle_subset > 0;
+}
+
+// Column index within handle lh mapping to global bank id `bid`. Legacy handles
+// (bank_ids empty) are POSITIONAL: column == the bank's index in the active set
+// (`pos_fallback`). Returns -1 if lh does not reside on bid.
+static int handle_col_of_bank(const LoadedHandle& lh, int bid, int pos_fallback) {
+  if (lh.bank_ids.empty()) return pos_fallback;
+  for (size_t c = 0; c < lh.bank_ids.size(); c++)
+    if (lh.bank_ids[c] == bid) return (int)c;
+  return -1;
+}
+
+// True iff the handle lives on a PROPER subset of `banks` (fewer, reordered, or a
+// bank now absent). False => the full-set fast path (no copy) is byte-identical.
+static bool handle_is_subset(const LoadedHandle& h,
+                             const std::vector<BankConfig>& banks) {
+  if (h.bank_ids.empty()) return false;
+  if (h.bank_ids.size() != banks.size()) return true;
+  for (size_t i = 0; i < banks.size(); i++)
+    if (banks[i].bank_id != h.bank_ids[i]) return true;
+  return false;
+}
+
+// Compact read-only COPY of `banks` in the handle's column order (only the banks
+// it resides on). Lets a serving path present the subset as banks[0..M-1] so
+// every banks[bk]/per_round_backup_rows[.][bk] indexing stays correct unchanged.
+static std::vector<BankConfig> handle_bank_view(const LoadedHandle& h,
+                                                std::vector<BankConfig>& banks) {
+  std::vector<BankConfig> out;
+  for (int bid : h.bank_ids)
+    for (auto& b : banks) if (b.bank_id == bid) { out.push_back(b); break; }
+  return out;
+}
